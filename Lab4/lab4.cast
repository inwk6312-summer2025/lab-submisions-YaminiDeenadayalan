[9338.833994, "o", "\u001b[51;75H          \u001b[10;48H\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[1;1H\u001b[38;5;81mfrom\u001b[m netmiko \u001b[38;5;81mimport\u001b[m ConnectHandler\r\n\u001b[38;5;81mimport\u001b[m yaml\r\n\u001b[38;5;81mfrom\u001b[m textfsm \u001b[38;5;81mimport\u001b[m clitable\r\n\r\n\u001b[96m# Load YAML\u001b[m\r\n\u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m\"devices.yml\"\u001b[m) \u001b[93mas\u001b[m f:\r\n    devices = yaml.safe_load(f)\r\n\r\n\u001b[96m# CLI Table for parsing\u001b[m\r\ncli_table = clitable.CliTable(\u001b[95m'index'\u001b[m, \u001b[95m'template'\u001b[m)\r\n\r\n\u001b[93mfor\u001b[m router \u001b[93min\u001b[m devices[\u001b[95m'all_routers'\u001b[m]:\r\n    \u001b[93mtry\u001b[m:\u001b[14;9Hconnection = ConnectHandler(\u001b[15;13Hdevice_type=router[\u001b[95m\"device_type\"\u001b[m],\u001b[16;13Hhost=router[\u001b[95m\"hostname\"\u001b[m],\u001b[17;13Husername=router[\u001b[95m\"username\"\u001b[m],\u001b[18;13Hpassword=router[\u001b[95m\"password\"\u001b[m]\u001b[19;9H)\u001b[21;9Houtput = connection.send_command(\u001b[95m\"show ip route\"\u001b[m)\u001b[22;9Hconnection.disconnect()\u001b[24;9Hattributes = {\u001b[95m\"Command\"\u001b[m: \u001b[95m\"show ip route\"\u001b[m, \u001b[95m\"Platform\"\u001b[m: \u001b[95m\"cisco_ios\"\u001b[m}\u001b[25;9Hcli_table.ParseCmd(output, attributes)\u001b[27;9H\u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"Routing Table for {"]
