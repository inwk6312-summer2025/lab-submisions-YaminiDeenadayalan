[8037.954681, "o", "\u001b[51;75H       \u001b[24;1H\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[1;1H\u001b[38;5;81mimport\u001b[m yaml\r\n\u001b[38;5;81mfrom\u001b[m jinja2 \u001b[38;5;81mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[38;5;81mfrom\u001b[m netmiko \u001b[38;5;81mimport\u001b[m ConnectHandler\r\n\r\n\u001b[96m# Load YAML\u001b[m\r\n\u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m\"devices.yaml\"\u001b[m) \u001b[93mas\u001b[m f:\r\n    devices = yaml.safe_load(f)\r\n\r\n\u001b[96m# Setup Jinja\u001b[m\r\nenv = Environment(loader=FileSystemLoader(\u001b[95m'.'\u001b[m))\r\ntemplate = env.get_template(\u001b[95m\"template.j2\"\u001b[m)\r\n\r\n\u001b[96m# Configure all routers\u001b[m\r\n\u001b[93mfor\u001b[m router \u001b[93min\u001b[m devices[\u001b[95m'all_routers'\u001b[m]:\r\n    config = template.render(**router)\r\n    \u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"Configuring {router['name']}\"\u001b[m)\u001b[18;5Hconnection = ConnectHandler(\u001b[19;9Hdevice_type=router[\u001b[95m\"device_type\"\u001b[m],\u001b[20;9Hhost=router[\u001b[95m\"hostname\"\u001b[m],\u001b[21;9Husername=router[\u001b[95m\"username\"\u001b[m],\u001b[22;9Hpassword=router[\u001b[95m\"password\"\u001b[m]\r\n    )\r\n    connection.send_config_set(config.splitlines())\r\n    connection.disconnect()\r\n\r\n\u001b[94m~                                         "]
