[8463.354166, "o", "\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[2;1H\u001b[38;5;81mimport\u001b[m logging\r\n\u001b[38;5;81mimport\u001b[m yaml\r\n\u001b[38;5;81mfrom\u001b[m jinja2 \u001b[38;5;81mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[38;5;81mfrom\u001b[m netmiko \u001b[38;5;81mimport\u001b[m ConnectHandler\r\n\r\n\u001b[96m# Setup logging\u001b[m\r\nlogging.basicConfig(filename=\u001b[95m\"network_config.log\"\u001b[m, level=logging.INFO)\r\n\r\n\u001b[96m# Load YAML\u001b[m\r\n\u001b[93mwith\u001b[m \u001b[1m\u001b[96mopen\u001b[m(\u001b[95m\"devices.yaml\"\u001b[m) \u001b[93mas\u001b[m f:\r\n    devices = yaml.safe_load(f)\r\n\r\n\u001b[96m# Setup Jinja\u001b[m\r\nenv = Environment(loader=FileSystemLoader(\u001b[95m'.'\u001b[m))\r\ntemplate = env.get_template(\u001b[95m\"template.j2\"\u001b[m)\r\n\r\n\u001b[96m# Configure all routers with logging\u001b[m\r\n\u001b[93mfor\u001b[m router \u001b[93min\u001b[m devices[\u001b[95m'all_routers'\u001b[m]:\r\n    \u001b[93mtry\u001b[m:\u001b[21;9Hconfig = template.render(**router)\u001b[22;9Hlogging.info(f\u001b[95m\"Connecting to {router['name']}\"\u001b[m)\u001b[24;9Hconnection = ConnectHandler(\u001b[25;13Hdevice_type=router[\u001b[95m\"device_type\"\u001b[m],\u001b[26;13Hhost=router[\u001b[95m\"hostname\"\u001b[m],\u001b[27;13Husername=router[\u001b[95m\"username\"\u001b[m],\u001b[28;13Hpassword=router[\u001b[95m"]
[8463.354631, "o", "\"password\"\u001b[m]\u001b[29;9H)\u001b[30;9Hconnection.send_config_set(config.splitlines())\u001b[31;9Hlogging.info(f\u001b[95m\"Successfully configured {router['name']}\"\u001b[m)\u001b[32;9Hconnection.disconnect()\r\n    \u001b[93mexcept\u001b[m \u001b[38;5;121mException\u001b[m \u001b[93mas\u001b[m e:\u001b[34;9Hlogging.error(f\u001b[95m\"Failed to configure {router['name']}: {str(e)}\"\u001b[m)\r\n\r\n\u001b[94m~                                                                                                     \u001b[37;1H~                                                                                                     \u001b[38;1H~                                                                                                     \u001b[39;1H~                                                                                                     \u001b[40;1H~                                                                                                     \u001b[41;1H~                                                                                                     "]
