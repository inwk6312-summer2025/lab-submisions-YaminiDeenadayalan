[9436.549509, "o", "\u001b[1;1H\u001b[35mfrom\u001b[m netmiko \u001b[35mimport\u001b[m ConnectHandler\r\n\u001b[35mimport\u001b[m yaml\r\n\u001b[35mfrom\u001b[m textfsm \u001b[35mimport\u001b[m clitable\r\n\r\n\u001b[34m# Load YAML\u001b[m\r\n\u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"devices.yml\"\u001b[m) \u001b[38;5;130mas\u001b[m f:\r\n    devices = yaml.safe_load(f)\r\n\r\n\u001b[34m# CLI Table for parsing\u001b[m\r\ncli_table = clitable.CliTable(\u001b[31m'index'\u001b[m, \u001b[31m'/home/student/Desktop/netmiko-lab/src/ntc-templates/templates''\u001b[m\u001b[11;1H)\r\n\r\n\u001b[38;5;130mfor\u001b[m router \u001b[38;5;130min\u001b[m devices[\u001b[31m'all_routers'\u001b[m]:\r\n    \u001b[38;5;130mtry\u001b[m:\u001b[15;9Hconnection = ConnectHandler(\u001b[16;13Hdevice_type=router[\u001b[31m\"device_type\"\u001b[m],\u001b[17;13Hhost=router[\u001b[31m\"hostname\"\u001b[m],\u001b[18;13Husername=router[\u001b[31m\"username\"\u001b[m],\u001b[19;13Hpassword=router[\u001b[31m\"password\"\u001b[m]\u001b[20;9H)\u001b[22;9Houtput = connection.send_command(\u001b[31m\"show ip route\"\u001b[m)\u001b[23;9Hconnection.disconnect()\u001b[25;9Hattributes = {\u001b[31m\"Command\"\u001b[m: \u001b[31m\"show ip route\"\u001b[m, \u001b[31m\"Platform\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m}\u001b[26;9Hcli_table.ParseCmd(output, attributes)\u001b[28;9H\u001b[36mprint\u001b[m(f\u001b[31m\"Routing Tabl"]
