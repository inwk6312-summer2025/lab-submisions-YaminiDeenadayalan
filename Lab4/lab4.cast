[8037.912179, "o", "\u001b[1;1H\u001b[35mimport\u001b[m yaml\r\n\u001b[35mfrom\u001b[m jinja2 \u001b[35mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[35mfrom\u001b[m netmiko \u001b[35mimport\u001b[m ConnectHandler\r\n\r\n\u001b[34m# Load YAML\u001b[m\r\n\u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m\"devices.yaml\"\u001b[m) \u001b[38;5;130mas\u001b[m f:\r\n    devices = yaml.safe_load(f)\r\n\r\n\u001b[34m# Setup Jinja\u001b[m\r\nenv = Environment(loader=FileSystemLoader(\u001b[31m'.'\u001b[m))\r\ntemplate = env.get_template(\u001b[31m\"template.j2\"\u001b[m)\r\n\r\n\u001b[34m# Configure all routers\u001b[m\r\n\u001b[38;5;130mfor\u001b[m router \u001b[38;5;130min\u001b[m devices[\u001b[31m'all_routers'\u001b[m]:\r\n    config = template.render(**router)\r\n    \u001b[36mprint\u001b[m(f\u001b[31m\"Configuring {router['name']}\"\u001b[m)\u001b[18;5Hconnection = ConnectHandler(\u001b[19;9Hdevice_type=router[\u001b[31m\"device_type\"\u001b[m],\u001b[20;9Hhost=router[\u001b[31m\"hostname\"\u001b[m],\u001b[21;9Husername=router[\u001b[31m\"username\"\u001b[m],\u001b[22;9Hpassword=router[\u001b[31m\"password\"\u001b[m]\r\n    )\r\n    connection.send_config_set(config.splitlines())\r\n    connection.disconnect()\r\n\r\n\u001b[94m~                                                                                                 "]
