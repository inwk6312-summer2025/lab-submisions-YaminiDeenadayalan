[558.519438, "o", "\u001b[?25l\u001b[95mi/running/'\u001b[m.format(HOST)\u001b[12;1H\u001b[K\u001b[13;1H\u001b[93mdef\u001b[m \u001b[1m\u001b[96mget_interfaces\u001b[m(append_url):\u001b[13;32H\u001b[K\u001b[14;1H    ur\u001b[14;7H\u001b[K\u001b[14;7H\u001b[?25h"]
[558.520752, "o", "\u001b[?25ll = BASE_URL + append_url\r\n    auth = HTTPBasicAuth(USER, PASS)\u001b[15;37H\u001b[K\u001b[16;1H \u001b[16;2H\u001b[K\u001b[16;2H\u001b[?25h"]
