[2316.420772, "o", "acd\"\u001b[m,\u001b[24;13H\u001b[95m\"enabled\"\u001b[m: \u001b[1m\u001b[96mTrue\u001b[m,\u001b[25;13H\u001b[95m\"ietf-ip:ipv4\"\u001b[m: {\u001b[26;17H\u001b[95m\"address\"\u001b[m: [\u001b[27;21H{\u001b[28;25H\u001b[95m\"ip\"\u001b[m: ip_addr,\u001b[29;25H\u001b[95m\"netmask\"\u001b[m: \u001b[95m\"255.255.255.0\"\u001b[m\u001b[30;21H}\u001b[31;17H]\u001b[32;13H},\u001b[33;13H\u001b[95m\"ietf-ip:ipv6\"\u001b[m: {}\u001b[34;9H}\r\n    }\r\n    \u001b[93mtry\u001b[m:\u001b[37;9Hresponse = requests.put(url, auth=auth, headers=headers, data=json.dumps(data), timeout=\u001b[95m5\u001b[m)\u001b[38;9H\u001b[93mif\u001b[m response.status_code == \u001b[95m204\u001b[m:\u001b[39;13Hlogging.info(f\u001b[95m\"{mgmt_ip} {interface}: Success\"\u001b[m)\u001b[40;9H\u001b[93melse\u001b[m:\u001b[41;13Hlogging.error(f\u001b[95m\"{mgmt_ip} {interface}: Failed ({response.status_code}) {response.text}\"\u001b[m)\r\n    \u001b[93mexcept\u001b[m \u001b[38;5;121mException\u001b[m \u001b[93mas\u001b[m e:\u001b[43;9Hlogging.error(f\u001b[95m\"{mgmt_ip} {interface}: Exception {e}\"\u001b[m)\r\n\r\n\u001b[96m# Iterate over routers and interfaces\u001b[m\r\n\u001b[93mfor\u001b[m router \u001b[93min\u001b[m routers:\r\n    mgmt_ip = router[\u001b[95m'mgmt_ip'\u001b[m]\r\n    \u001b[93mfor\u001b[m interface, ip_addr \u001b[93min"]
