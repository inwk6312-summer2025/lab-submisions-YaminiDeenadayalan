[558.510929, "o", "\u001b[?25lvel=logging.INFO, \u001b[1m\u001b[96mformat\u001b[m=\u001b[95m'%(name)s - %(levelname)s - %(\u001b[?25h"]
[558.516831, "o", "\u001b[?25lmessage)s'\u001b[m)\u001b[7;1H\u001b[K\u001b[8;1HHOST = \u001b[95m'192.168.1.101'\u001b[m\u001b[8;23H\u001b[K\u001b[9;1HUSER \u001b[9;6H\u001b[K\u001b[9;6H\u001b[?25h"]
