[2682.321234, "o", "\u001b[1;1Hlogging.basicConfig(level=logging.INFO, \u001b[36mformat\u001b[m=\u001b[31m'%(name)s - %(levelname)s - %(message)s'\u001b[m)\r\n\r\n\u001b[34m# Credentials (update as needed)\u001b[m\r\nUSER = \u001b[31m'student'\u001b[m\r\nPASS = \u001b[31m'Meilab123'\u001b[m\r\n\r\n\u001b[34m# Read YAML file\u001b[m\r\n\u001b[38;5;130mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m'routers.yaml'\u001b[m, \u001b[31m'r'\u001b[m) \u001b[38;5;130mas\u001b[m f:\r\n    routers = yaml.safe_load(f)[\u001b[31m'routers'\u001b[m]\r\n\r\n\u001b[38;5;130mdef\u001b[m \u001b[36mset_interface\u001b[m(mgmt_ip, interface, ip_addr):\r\n    url = f\u001b[31m\"http://{mgmt_ip}/restconf/api/running/interfaces/interface/{interface}\"\u001b[m\r\n    auth = HTTPBasicAuth(USER, PASS)\r\n    headers = {\u001b[15;9H\u001b[31m'Accept'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m,\u001b[16;9H\u001b[31m'Content-Type'\u001b[m: \u001b[31m'application/vnd.yang.data+json'\u001b[m\r\n    }\r\n    data = {\u001b[19;9H\u001b[31m\"ietf-interfaces:interface\"\u001b[m: {\u001b[20;13H\u001b[31m\"name\"\u001b[m: interface,\u001b[21;13H\u001b[31m\"description\"\u001b[m: f\u001b[31m\"Configured by RESTCONF\"\u001b[m,\u001b[22;13H\u001b[31m\"type\"\u001b[m: \u001b[31m\"iana-if-type:ethernetCsmacd\"\u001b[m,\u001b[23;13H\u001b[31m\"enabled\"\u001b[m: \u001b[36mTrue\u001b[m,\u001b[24;13H\u001b[31m\"ietf-ip"]
[2682.321792, "o", ":ipv4\"\u001b[m: {\u001b[25;17H\u001b[31m\"address\"\u001b[m: [\u001b[26;21H{\u001b[27;25H\u001b[31m\"ip\"\u001b[m: ip_addr,\u001b[28;25H\u001b[31m\"netmask\"\u001b[m: \u001b[31m\"255.255.255.0\"\u001b[m\u001b[29;21H}\u001b[30;17H]\u001b[31;13H},\u001b[32;13H\u001b[31m\"ietf-ip:ipv6\"\u001b[m: {}\u001b[33;9H}\r\n    }\r\n    \u001b[38;5;130mtry\u001b[m:\u001b[36;9Hresponse = requests.put(url, auth=auth, headers=headers, data=json.dumps(data), timeout=\u001b[31m5\u001b[m)\u001b[37;9H\u001b[38;5;130mif\u001b[m response.status_code == \u001b[31m204\u001b[m:\u001b[38;13Hlogging.info(f\u001b[31m\"{mgmt_ip} {interface}: Success\"\u001b[m)\u001b[39;9H\u001b[38;5;130melse\u001b[m:\u001b[40;13Hlogging.error(f\u001b[31m\"{mgmt_ip} {interface}: Failed ({response.status_code}) {response.text}\"\u001b[m)\r\n    \u001b[38;5;130mexcept\u001b[m \u001b[32mException\u001b[m \u001b[38;5;130mas\u001b[m e:\u001b[42;9Hlogging.error(f\u001b[31m\"{mgmt_ip} {interface}: Exception {e}\"\u001b[m)\r\n\r\n\u001b[34m# Iterate over routers and interfaces\u001b[m\r\n\u001b[38;5;130mfor\u001b[m router \u001b[38;5;130min\u001b[m routers:\r\n    mgmt_ip = router[\u001b[31m'mgmt_ip'\u001b[m]\r\n    \u001b[36mprint\u001b[m(f\u001b[31m\"mgmtp %s {mgmt_ip}\"\u001b[m)\r\n    \u001b[38;5;130mfor\u001b[m interface, ip_addr "]
