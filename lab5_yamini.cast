[2047.2601, "o", "\u001b[?25lson\r\n\u001b[38;5;81mimport\u001b[m logging\u001b[5;15H\u001b[K\u001b[6;1H\u001b[K\u001b[7;1H\u001b[96m# Logging \u001b[m\u001b[7;11H\u001b[K\u001b[7;11H\u001b[?25h"]
[2047.261064, "o", "\u001b[?25l\u001b[96msetup\u001b[m\r\nlogging.basicConfig(level=logging.INFO, \u001b[1m\u001b[96mformat\u001b[m=\u001b[95m'%\u001b[m\u001b[8;50H\u001b[K\u001b[8;50H\u001b[?25h"]
