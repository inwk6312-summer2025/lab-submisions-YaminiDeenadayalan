[338.939607, "o", "  +--ro routing-state"]
[338.940031, "o", "\r\n"]
[338.940566, "o", "  |  +--ro routing-instance* [name]"]
[338.940956, "o", "\r\n"]
[338.941477, "o", "  |     +--ro name                 string"]
[338.94191, "o", "\r\n"]
[338.942348, "o", "  |     +--ro type?                identityref"]
[338.942719, "o", "\r\n"]
[338.943191, "o", "  |     +--ro router-id?           yang:dotted-quad"]
[338.943598, "o", "\r\n"]
[338.94406, "o", "  |     +--ro interfaces"]
[338.944438, "o", "\r\n"]
[338.9449, "o", "  |     |  +--ro interface*   if:interface-state-ref"]
[338.945282, "o", "\r\n"]
[338.945776, "o", "  |     +--ro routing-protocols"]
[338.946159, "o", "\r\n"]
[338.946662, "o", "  |     |  +--ro routing-protocol* [type name]"]
[338.947064, "o", "\r\n"]
[338.947559, "o", "  |     |     +--ro type    identityref"]
[338.948073, "o", "\r\n"]
[338.948551, "o", "  |     |     +--ro name    string"]
[338.948961, "o", "\r\n"]
[338.949412, "o", "  |     +--ro ribs"]
[338.949824, "o", "\r\n"]
[338.9503, "o", "  |        +--ro rib* [name]"]
[338.95068, "o", "\r\n"]
[338.95111, "o", "  |           +--ro name              string"]
[338.951549, "o", "\r\n"]
[338.95199, "o", "  |           +--ro address-family    identityref"]
[338.952411, "o", "\r\n"]
[338.952857, "o", "  |           +--ro default-rib?      boolean {multiple-ribs}?"]
[338.953245, "o", "\r\n"]
[338.95358, "o", "  |           +--ro routes"]
[338.954057, "o", "\r\n"]
[338.954377, "o", "  |              +--ro route* [destination-prefix]"]
[338.954627, "o", "\r\n"]
[338.955022, "o", "  |                 +--ro route-preference?     route-preference"]
[338.955662, "o", "\r\n"]
[338.956002, "o", "  |                 +--ro destination-prefix    string"]
[338.956255, "o", "\r\n"]
[338.956558, "o", "  |                 +--ro metric?               uint32"]
[338.956801, "o", "\r\n"]
[338.957119, "o", "  |                 +--ro next-hop"]
[338.95737, "o", "\r\n"]
[338.957701, "o", "  |                 |  +--ro (next-hop-options)"]
[338.957949, "o", "\r\n"]
[338.958319, "o", "  |                 |     +--:(simple-next-hop)"]
[338.959439, "o", "\r\n"]
[338.959754, "o", "  |                 |     |  +--ro outgoing-interface?   string"]
[338.960019, "o", "\r\n"]
[338.960345, "o", "  |                 |     |  +--ro next-hop-address?     string"]
[338.960603, "o", "\r\n"]
[338.960927, "o", "  |                 |     +--:(special-next-hop)"]
[338.961199, "o", "\r\n"]
[338.961552, "o", "  |                 |        +--ro special-next-hop?     enumeration\r\n"]
[338.961969, "o", "  |                 +--ro source-protocol       identityref\r\n  |                 +--ro active?               empty\r\n"]
[338.962347, "o", "  |                 +--ro last-updated?         yang:date-and-time\r\n  |                 +--ro update-source?        string"]
[338.962669, "o", "\r\n  +--rw routing\r\n"]
[338.963044, "o", "     +--rw routing-instance* [name]"]
[338.963417, "o", "\r\n        +--rw name                 string\r\n        +--rw type?                identityref"]
[338.963773, "o", "\r\n        +--rw enabled?             boolean"]
[338.96527, "o", "\r\n        +--rw router-id?           yang:dotted-quad {router-id}?"]
[338.965706, "o", "\r\n        +--rw description?         string\r\n        +--rw interfaces"]
[338.96602, "o", "\r\n        |  +--rw interface*   if:interface-ref"]
[338.966449, "o", "\r\n        +--rw routing-protocols\r\n        |  +--rw routing-protocol* [type name]"]
[338.966855, "o", "\r\n        |     +--rw type             identityref\r\n        |     +--rw name             string"]
[338.967158, "o", "\r\n        |     +--rw description?     string"]
[338.967598, "o", "\r\n        |     +--rw static-routes\r\n        +--rw ribs\r\n"]
[338.968163, "o", "           +--rw rib* [name]\r\n              +--rw name              string"]
[338.968472, "o", "\r\n"]
[338.968795, "o", "              +--rw address-family?   identityref"]
[338.969043, "o", "\r\n"]
[338.969397, "o", "              +--rw description?      string\r\n"]
[338.970807, "o", "\r\n  augment /if:interfaces-state/if:interface:"]
[338.971125, "o", "\r\n    +--ro routing-instance?   string\r\n"]
[338.971447, "o", "\r\n  rpcs:\r\n    +---x fib-route\r\n"]
[338.971802, "o", "       +---w input\r\n       |  +---w routing-instance-name    string"]
[338.972067, "o", "\r\n       |  +---w destination-address"]
[338.972338, "o", "\r\n       |     +---w address-family    identityref"]
[338.972616, "o", "\r\n       +--ro output\r\n"]
[338.97297, "o", "          +--ro route\r\n             +--ro address-family     identityref"]
[338.973318, "o", "\r\n             +--ro next-hop\r\n             |  +--ro (next-hop-options)"]
[338.973596, "o", "\r\n             |     +--:(simple-next-hop)"]
[338.973867, "o", "\r\n             |     |  +--ro outgoing-interface?   string"]
[338.974213, "o", "\r\n             |     |  +--ro next-hop-address?     string\r\n             |     +--:(special-next-hop)"]
[338.975519, "o", "\r\n             |        +--ro special-next-hop?     enumeration"]
[338.976022, "o", "\r\n             +--ro source-protocol    identityref\r\n             +--ro active?            empty"]
[338.976376, "o", "\r\n             +--ro last-updated?      yang:date-and-time"]
[338.981804, "o", "\r\n"]
