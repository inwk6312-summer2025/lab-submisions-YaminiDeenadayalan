[1717.250704, "o", "\u001b]0;student@6312vm-csr40: ~/Desktop/docker-lab\u0007\u001b[01;32mstudent@6312vm-csr40\u001b[00m:\u001b[01;34m~/Desktop/docker-lab\u001b[00m$ "]
[1783.284208, "o", "git clone --single-branch --branch dist-amd64\r\n"]
[1783.662264, "o", "fatal: You must specify a repository to clone."]
[1783.663066, "o", "\r\n"]
[1783.663486, "o", "\r\n"]
[1783.663908, "o", "usage: git clone [<options>] [--] <repo> [<dir>]"]
[1783.664303, "o", "\r\n"]
[1783.664778, "o", "\r\n"]
[1783.665168, "o", "    "]
[1783.665605, "o", "-v"]
[1783.665996, "o", ", "]
[1783.666361, "o", "--verbose"]
[1783.666739, "o", "         be more verbose"]
[1783.667114, "o", "\r\n"]
[1783.667502, "o", "    "]
[1783.667939, "o", "-q"]
[1783.668354, "o", ", "]
[1783.668744, "o", "--quiet"]
[1783.669147, "o", "           be more quiet"]
[1783.669585, "o", "\r\n"]
[1783.669974, "o", "    "]
[1783.67035, "o", "--progress"]
[1783.670722, "o", "            force progress reporting"]
[1783.671137, "o", "\r\n"]
[1783.671527, "o", "    "]
[1783.671899, "o", "-n"]
[1783.672286, "o", ", "]
[1783.672707, "o", "--no-checkout"]
[1783.673119, "o", "     don't create a checkout"]
[1783.6735, "o", "\r\n"]
[1783.6738, "o", "    "]
[1783.674094, "o", "--bare"]
[1783.674648, "o", "                create a bare repository"]
[1783.674897, "o", "\r\n"]
[1783.675183, "o", "    "]
[1783.675444, "o", "--mirror"]
[1783.675703, "o", "              create a mirror repository (implies bare)"]
[1783.675937, "o", "\r\n"]
[1783.676176, "o", "    "]
[1783.676455, "o", "-l"]
[1783.67673, "o", ", "]
[1783.676976, "o", "--local"]
[1783.677257, "o", "           to clone from a local repository"]
[1783.677529, "o", "\r\n    --no-hardlinks"]
[1783.679014, "o", "        don't use local hardlinks, always copy\r\n    -s, --shared          setup as shared repository\r\n    --recursive ...       "]
[1783.679362, "o", "alias of --recurse-submodules\r\n    --recurse-submodules[=<pathspec>]\r\n                          initialize submodules in the clone\r\n    -j, --jobs <n>        number of submodules cloned in parallel"]
[1783.67968, "o", "\r\n    --template <template-directory>\r\n                          directory from which templates will be used\r\n    --reference <repo>    reference repository\r\n    --reference-if-able <repo>\r\n"]
[1783.679974, "o", "                          reference repository\r\n    --dissociate          use --reference only while cloning\r\n    -o, --origin <name>   use <name> instead of 'origin' to track upstream\r\n    "]
[1783.680276, "o", "-b, --branch <branch>\r\n                          checkout <branch> instead of the remote's HEAD\r\n    -u, "]
[1783.680632, "o", "--upload-pack <path>\r\n                          path to git-upload-pack on the remote\r\n    --depth <depth>       create a shallow clone of that depth\r\n    --shallow-since <time>"]
[1783.680962, "o", "\r\n                          create a shallow clone since a specific time\r\n    --shallow-exclude <revision>\r\n                          deepen history of shallow clone, excluding rev\r\n    "]
[1783.681323, "o", "--single-branch       clone only one branch, HEAD or --branch\r\n    --no-tags             don't clone any tags, and make later fetches not to follow them\r\n    --shallow-submodules  any cloned submodules will be shallow\r\n    --separate-git-dir <gitdir>"]
[1783.681668, "o", "\r\n                          separate git dir from working tree\r\n    -c, --config <key=value>\r\n"]
[1783.682027, "o", "                          set config inside the new repository\r\n    --server-option <server-specific>\r\n                          option to transmit\r\n    -4, --ipv4            use IPv4 addresses only\r\n"]
[1783.682324, "o", "    -6, --ipv6            use IPv6 addresses only\r\n    --filter <args>"]
[1783.682635, "o", "       object filtering\r\n    --remote-submodules   any cloned submodules will use their remote-tracking branch\r\n    --sparse              initialize sparse-checkout file to include only files at root"]
[1783.683965, "o", "\r\n\r\n\u001b]0;student@6312vm-csr40: ~/Desktop/docker-lab\u0007\u001b[01;32mstudent@6312vm-csr40\u001b[00m:\u001b[01;34m~/Desktop/docker-lab\u001b[00m$ https://github.com/tianon/docker-brew-ubuntu-core.git"]
