[3827.032309, "o", "\u001b[1;1H\u001b[35mfrom\u001b[m jinja2 \u001b[35mimport\u001b[m Environment, FileSystemLoader\r\n\r\n\u001b[34m# Set up the Jinja2 environment\u001b[m\r\nENV = Environment(loader=FileSystemLoader(\u001b[31m'.'\u001b[m))\r\n\r\n\u001b[34m# Load the template for Task 4\u001b[m\r\ntemplate = ENV.get_template(\u001b[31m\"template-task4.j2\"\u001b[m)\r\n\r\n\u001b[34m# Define the interface configuration object\u001b[m\r\n\u001b[38;5;130mclass\u001b[m \u001b[36mNetworkInterface\u001b[m(\u001b[36mobject\u001b[m):\r\n    \u001b[38;5;130mdef\u001b[m \u001b[36m__init__\u001b[m(self, description, vlan):\u001b[12;9Hself.description = description\u001b[13;9Hself.vlan = vlan\r\n\r\n\u001b[34m# Create a single interface object\u001b[m\r\ninterface_obj = NetworkInterface(\u001b[31m\"Office Port\"\u001b[m, \u001b[31m10\u001b[m)\r\n\r\n\u001b[34m# Render the template and print the result\u001b[m\r\n\u001b[36mprint\u001b[m\u001b[106m(\u001b[mtemplate.render(interface=interface_obj)\u001b[106m)\u001b[m\r\n\u001b[94m~                                                                                                     \u001b[21;1H~                                                                                                     \u001b[22;1H~                                        "]
